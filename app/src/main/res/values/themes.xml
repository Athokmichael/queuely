<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QueueLy" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/usiu_navy</item>
        <item name="colorPrimaryDark">@color/usiu_navy_dark</item>
        <item name="colorAccent">@color/usiu_gold</item>
        <item name="android:statusBarColor">@color/usiu_navy_dark</item>
        <item name="android:windowBackground">@color/usiu_light_gray</item>
    </style>

    <style name="QueueLy.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/usiu_navy</item>
        <item name="titleTextColor">@color/usiu_white</item>
        <item name="subtitleTextColor">@color/usiu_gold</item>
    </style>

    <style name="QueueLy.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/usiu_gold</item>
        <item name="android:textColor">@color/usiu_navy</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="QueueLy.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/usiu_navy</item>
        <item name="android:textColor">@color/usiu_navy</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="QueueLy.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/usiu_red</item>
        <item name="android:textColor">@color/usiu_white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="QueueLy.Button.Success" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/usiu_green</item>
        <item name="android:textColor">@color/usiu_white</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="QueueLy.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/usiu_white</item>
    </style>
</resources>
